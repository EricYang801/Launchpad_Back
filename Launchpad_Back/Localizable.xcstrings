    "F4 works on its own, like the original Launchpad key. Press Esc to cancel recording.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 可單獨使用，就像原本的 Launchpad 按鍵。錄製時按 Esc 可取消。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "F4 可单独使用，就像原来的启动台按键。录制时按 Esc 取消。"
          }
        }
      }
    },
