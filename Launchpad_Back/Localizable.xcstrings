{
  "sourceLanguage": "en",
  "strings": {
    "All folders are removed and apps are sorted by name.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料夾都會移除，應用程式會依名稱排序。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有文件夹都将被移除，应用将按名称排序。"
          }
        }
      }
    },
